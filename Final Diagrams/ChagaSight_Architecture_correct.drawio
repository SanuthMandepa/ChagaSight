        <mxCell id="39" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b3fa0;strokeWidth=0.8;endArrow=block;endFill=1;" parent="1" source="34" target="35" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="40" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b3fa0;strokeWidth=0.8;endArrow=block;endFill=1;" parent="1" source="35" target="36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="41" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b3fa0;strokeWidth=0.8;endArrow=block;endFill=1;" parent="1" source="36" target="37" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="42" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b3fa0;strokeWidth=0.8;endArrow=block;endFill=1;" parent="1" source="37" target="38" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;REPA alignment module&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Projection head: depthwise conv → SiLU → linear projection (768 → 768)&lt;br&gt;Cosine similarity alignment loss (λ=0.5, FM features detached) — training only&lt;br&gt;Aligns 2D-ViT features into FM embedding space → aligned 768-dim&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdeee0;strokeColor=#ca6f1e;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="68" y="934" width="886" height="72" as="geometry" />
        </mxCell>
        <mxCell id="44" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#2474b5;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9;" parent="1" source="29" target="43" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="45" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b3fa0;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9;" parent="1" source="38" target="43" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="46" value="&lt;b&gt;Feature fusion&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Concatenate: aligned 2D-ViT (768-dim) || FM-conditioned (768-dim)&lt;br&gt;→ 1536-dim joint representation&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="162" y="1022" width="698" height="52" as="geometry" />
        </mxCell>
        <mxCell id="47" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#ca6f1e;strokeWidth=1.2;endArrow=block;endFill=1;fontSize=9;" parent="1" source="43" target="46" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="48" value="&lt;b&gt;Classification head&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;MLP: 1536 → 512 → 256 → 1  (ReLU, Dropout 0.3)&lt;br&gt;Sigmoid output  |  Asymmetric BCE: γ⁺=0, γ⁻=2, pos_weight=10&lt;br&gt;Soft labels: CODE-15% negatives → 0.2  (label noise tolerance)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdeee0;strokeColor=#ca6f1e;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
