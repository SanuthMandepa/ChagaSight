        <mxCell id="25" value="&lt;b&gt;Resample to 500 Hz&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Scipy signal resampling&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#aed6f1;strokeColor=#2474b5;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#0a3a5c;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="28" y="574" width="428" height="40" as="geometry" />
        </mxCell>
        <mxCell id="62" value="&lt;b&gt;Z-score normalise (per lead) + clip&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Mean=0, std=1 per channel | Hard clip ±3&amp;sigma; (prevents ViT artefacts)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#aed6f1;strokeColor=#2474b5;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#0a3a5c;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="28" y="624" width="428" height="40" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;Signal augments (training only)&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Lead-mixup | Powerline noise | Random shift&lt;br&gt;Applied to 1D signal before WCT image construction&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2474b5;strokeWidth=1;dashed=1;dashPattern=8 4;fontStyle=1;fontSize=11;fontColor=#0a3a5c;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="28" y="674" width="428" height="50" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;2D image builder&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;WCT re-referencing: RA / LA / LL electrode views&lt;br&gt;Scale to uint8 [0,255]  |  Output: (3, 24, 2048)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#aed6f1;strokeColor=#2474b5;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#0a3a5c;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="28" y="734" width="428" height="58" as="geometry" />
        </mxCell>
        <mxCell id="29" value="&lt;b&gt;2D-ViT encoder  (MAE pretrained)&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Rectangular patches 8×64 | 12 layers | 12 heads&lt;br&gt;Extract all 12 layer outputs | AoL avg pooling → 768-dim&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#85c8e8;strokeColor=#2474b5;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#0a3a5c;align=center;verticalAlign=middle;" parent="1" vertex="1">
