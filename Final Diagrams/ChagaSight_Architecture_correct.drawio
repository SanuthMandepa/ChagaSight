        <mxCell id="34" value="&lt;b&gt;Resample to 100 Hz&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Scipy signal resampling&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7b6e8;strokeColor=#7b3fa0;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#3d1460;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="544" y="574" width="428" height="40" as="geometry" />
        </mxCell>
        <mxCell id="35" value="&lt;b&gt;Z-score normalise (per lead)&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Mean=0, std=1 per channel (no clipping for 1D path)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7b6e8;strokeColor=#7b3fa0;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#3d1460;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="544" y="624" width="428" height="40" as="geometry" />
        </mxCell>
        <mxCell id="36" value="&lt;b&gt;Signal augments (training only)&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Powerline noise (50/60 Hz, SNR 15–30 dB) | Lead-mixup&lt;br&gt;Random shift | Amplitude scaling | Baseline wander&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b3fa0;strokeWidth=1;dashed=1;dashPattern=8 4;fontStyle=1;fontSize=11;fontColor=#3d1460;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="544" y="674" width="428" height="50" as="geometry" />
        </mxCell>
        <mxCell id="37" value="&lt;b&gt;Foundation model  (ST-MEM pretrained)&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;1D-ViT | 12 transformer blocks | 12 heads&lt;br&gt;Patch size: 50 | Input: (12, 1000) | Per-lead embeddings&lt;br&gt;AoL avg pooling → 768-dim&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#c49fd9;strokeColor=#7b3fa0;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#3d1460;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="544" y="734" width="428" height="68" as="geometry" />
        </mxCell>
        <mxCell id="38" value="&lt;b&gt;Demographics encoder  (FiLM conditioning)&lt;/b&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;&lt;br&gt;Input: age (normalised), sex (binary)&lt;br&gt;MLP: 2 → [gamma, beta]  |  X&#39; = gamma × X + beta&lt;br&gt;Affine modulation of 768-dim FM output in-place&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d7b6e8;strokeColor=#7b3fa0;strokeWidth=1;fontStyle=1;fontSize=11;fontColor=#3d1460;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="544" y="812" width="428" height="68" as="geometry" />
