        <mxCell id="12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="150" y="330" width="3000" height="210" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;PREPROCESSING PIPELINE&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#2D5016;" vertex="1" parent="1">
          <mxGeometry x="165" y="335" width="300" height="28" as="geometry" />
        </mxCell>
        <!-- Bandpass -->
        <mxCell id="14" value="&lt;b&gt;Butterworth Bandpass&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;0.5 – 40 Hz, Order 4&lt;br/&gt;scipy.signal.filtfilt&lt;br/&gt;(zero-phase)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="370" width="220" height="90" as="geometry" />
        </mxCell>
        <!-- Z-score -->
        <mxCell id="15" value="&lt;b&gt;Z-score Normalization&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Per-lead: (x − μ) / (σ + ε)&lt;br/&gt;±3σ clipping | float32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="530" y="370" width="220" height="90" as="geometry" />
        </mxCell>
        <!-- Augmentation -->
        <mxCell id="16" value="&lt;b&gt;Data Augmentation&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Lead Mixup (p=0.3, α=0.2)&lt;br/&gt;Powerline Noise (p=0.5, SNR 15–30 dB)&lt;br/&gt;Random Shift ±1s (p=0.5)&lt;br/&gt;Amplitude Scale 0.8–1.2 (p=0.3)&lt;br/&gt;Baseline Wander 0.1–0.5 Hz (p=0.2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="360" width="290" height="110" as="geometry" />
        </mxCell>
        <!-- Soft Labels -->
        <mxCell id="17" value="&lt;b&gt;Soft Labels&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;CODE-15% only&lt;br/&gt;Positive → 0.8&lt;br/&gt;Negative → 0.2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1260" y="370" width="180" height="90" as="geometry" />
        </mxCell>
        <!-- Weighted Sampler -->
        <mxCell id="18" value="&lt;b&gt;Weighted Sampler&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;5x oversample positives&lt;br/&gt;Stratified 5-fold CV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1550" y="370" width="200" height="90" as="geometry" />
        </mxCell>
        <!-- Preprocess edges -->
        <mxCell id="19" edge="1" source="8" target="14" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="20" edge="1" source="14" target="15" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="21" edge="1" source="15" target="16" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="22" edge="1" source="16" target="17" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="23" edge="1" source="17" target="18" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 1D PATH BG -->
        <mxCell id="24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="150" y="570" width="1440" height="400" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#4B0082&quot;&gt;1D SIGNAL PATH&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="165" y="575" width="250" height="28" as="geometry" />
        </mxCell>

        <!-- 2D PATH BG -->
        <mxCell id="26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="1710" y="570" width="1440" height="400" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#7D4800&quot;&gt;2D IMAGE PATH&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1725" y="575" width="250" height="28" as="geometry" />
        </mxCell>

        <!-- 1D Resample -->
        <mxCell id="28" value="&lt;b&gt;Resample to 100 Hz&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Output: (12, 1000)&lt;br/&gt;10 seconds @ 100 Hz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="615" width="220" height="70" as="geometry" />
        </mxCell>
        <!-- ST-MEM -->
        <mxCell id="29" value="&lt;b&gt;ST-MEM Pretraining&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Masked ECG Modeling (MAE-style)&lt;br/&gt;75% mask ratio — per-lead masking&lt;br/&gt;Decoder: 4 layers, 512-dim (discarded)&lt;br/&gt;Loss: MSE on masked patches only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#6c3fa0;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="260" height="100" as="geometry" />
        </mxCell>
        <!-- ViT1D_FM summary -->
        <mxCell id="30" value="&lt;b&gt;ViT1D_FM Encoder&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Input: (B, 12, 1000)&lt;br/&gt;PatchEmbed1D: (B, 240, 768)&lt;br/&gt;12x TransformerLayer [768-dim, 12 heads]&lt;br/&gt;AoL aggregation: (B, 768)&lt;br/&gt;~77M parameters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="360" height="110" as="geometry" />
        </mxCell>
        <!-- Demographics Encoder -->
        <mxCell id="31" value="&lt;b&gt;Demographics Encoder&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Input: (age_centuries, sex_binary)&lt;br/&gt;MLP: 2 to 256 to 256 to 1536 (ReLU)&lt;br/&gt;Split: gamma (B,768), beta (B,768)&lt;br/&gt;Modulation: feat = gamma x feat + beta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#6c3fa0;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="560" y="740" width="360" height="100" as="geometry" />
        </mxCell>
        <!-- fm_features label -->
        <mxCell id="32" value="fm_features (B, 768)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="970" y="650" width="160" height="25" as="geometry" />
        </mxCell>

        <!-- WCT Image -->
        <mxCell id="33" value="&lt;b&gt;WCT Image Construction&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Wilson Central Terminal re-referencing&lt;br/&gt;3 channels: RA, LA, LL reference frames&lt;br/&gt;Each channel: 12 leads x 2 rows = 24 height&lt;br/&gt;Resample to 500 Hz: 2048 samples wide&lt;br/&gt;Uint8 [0,255], 3-sigma clipping&lt;br/&gt;Output: (3, 24, 2048) uint8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1760" y="605" width="320" height="130" as="geometry" />
        </mxCell>
        <!-- MAE -->
        <mxCell id="34" value="&lt;b&gt;MAE Pretraining&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Masked Autoencoder (2D image)&lt;br/&gt;75% mask ratio&lt;br/&gt;Decoder: 4 layers, 512-dim (discarded)&lt;br/&gt;Loss: MSE on masked patches only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#b37600;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1760" y="760" width="260" height="100" as="geometry" />
        </mxCell>
        <!-- ViT2D summary -->
        <mxCell id="35" value="&lt;b&gt;ViT2D Encoder&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Input: (B, 3, 24, 2048) uint8&lt;br/&gt;Normalize [0,1] then PatchEmbed2D: (B, 96, 768)&lt;br/&gt;12x TransformerLayer [768-dim, 12 heads]&lt;br/&gt;AoL aggregation: (B, 768)&lt;br/&gt;~85M parameters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="2170" y="600" width="360" height="120" as="geometry" />
        </mxCell>
        <!-- features_2d label -->
        <mxCell id="36" value="features_2d (B, 768)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="2580" y="650" width="160" height="25" as="geometry" />
        </mxCell>

        <!-- Dual path edges -->
        <mxCell id="37" edge="1" source="18" target="28" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="38" edge="1" source="28" target="29" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="39" value="pretrained weights" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=10;" edge="1" source="29" target="30" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="40" edge="1" source="31" target="30" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="800" /><mxPoint x="740" y="670" /></Array></mxGeometry></mxCell>
        <mxCell id="41" edge="1" source="18" target="33" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="42" edge="1" source="33" target="34" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="43" value="pretrained weights" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;" edge="1" source="34" target="35" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- HYBRID MODEL BG -->
        <mxCell id="44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="150" y="1000" width="3000" height="420" as="geometry" />
        </mxCell>
        <mxCell id="45" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;HYBRID MODEL: HybridChagasModel&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="165" y="1005" width="500" height="28" as="geometry" />
        </mxCell>

        <!-- ViT1D_FM fine-tune -->
        <mxCell id="46" value="&lt;b&gt;ViT1D_FM&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;FROZEN in Phase 1&lt;br/&gt;Trainable in Phase 2&lt;br/&gt;Output: fm_features (B, 768)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="220" y="1050" width="230" height="90" as="geometry" />
        </mxCell>
        <!-- Demographics fine-tune -->
        <mxCell id="47" value="&lt;b&gt;Demographics&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Age (centuries), Sex (0/1)&lt;br/&gt;Modulation: gamma, beta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#6c3fa0;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="220" y="1175" width="230" height="70" as="geometry" />
        </mxCell>
        <!-- ViT2D fine-tune -->
        <mxCell id="48" value="&lt;b&gt;ViT2D&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Trainable both phases&lt;br/&gt;Output: features_2d (B, 768)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="1050" width="230" height="90" as="geometry" />
        </mxCell>
        <!-- REPA -->
        <mxCell id="49" value="&lt;b&gt;REPA Alignment&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Depthwise Conv1d(768, groups=768)&lt;br/&gt;SiLU then Linear(768 to 768)&lt;br/&gt;Output: aligned_2d (B, 768)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="1175" width="280" height="90" as="geometry" />
        </mxCell>
        <!-- Cosine Loss -->
        <mxCell id="50" value="&lt;b&gt;L_align&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;1 - cos_sim(aligned_2d, fm_features.detach())&lt;br/&gt;FM features DETACHED (no grad through FM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="600" y="1315" width="320" height="65" as="geometry" />
        </mxCell>
        <!-- Concat -->
        <mxCell id="51" value="&lt;b&gt;Concatenate&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[fm_features || aligned_2d]&lt;br/&gt;(B,768) + (B,768) = (B, 1536)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1090" width="280" height="70" as="geometry" />
        </mxCell>
        <!-- MLP Classifier -->
        <mxCell id="52" value="&lt;b&gt;MLP Classifier&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Linear(1536 to 512) + ReLU + Dropout(0.3)&lt;br/&gt;Linear(512 to 256) + ReLU + Dropout(0.3)&lt;br/&gt;Linear(256 to 1) = logits (B,)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1200" width="320" height="90" as="geometry" />
        </mxCell>
        <!-- BCE Loss -->
        <mxCell id="53" value="&lt;b&gt;Asymmetric BCE Loss&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;gamma_plus=0.0, gamma_minus=2.0, w_pos=10.0&lt;br/&gt;L_total = L_bce + 0.5 x L_align&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1335" width="300" height="70" as="geometry" />
        </mxCell>
        <!-- Outputs dict -->
        <mxCell id="54" value="&lt;b&gt;Forward returns:&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;logits: (B,)&lt;br/&gt;fm_features: (B, 768)&lt;br/&gt;aligned_2d_features: (B, 768)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1100" width="250" height="90" as="geometry" />
        </mxCell>
        <!-- Hybrid model edges -->
        <mxCell id="55" edge="1" source="30" target="46" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="56" edge="1" source="35" target="48" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="57" edge="1" source="47" target="46" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="1215" /><mxPoint x="335" y="1120" /></Array></mxGeometry></mxCell>
        <mxCell id="58" edge="1" source="48" target="49" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="59" edge="1" source="46" target="51" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="1095" /><mxPoint x="1050" y="1125" /></Array></mxGeometry></mxCell>
        <mxCell id="60" edge="1" source="49" target="51" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1220" /><mxPoint x="880" y="1125" /><mxPoint x="1050" y="1125" /></Array></mxGeometry></mxCell>
        <mxCell id="61" edge="1" source="51" target="52" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="62" edge="1" source="52" target="53" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="63" edge="1" source="49" target="50" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="64" edge="1" source="51" target="54" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- TRAINING PHASES BG -->
        <mxCell id="65" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="150" y="1460" width="3000" height="310" as="geometry" />
        </mxCell>
        <mxCell id="66" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;TRAINING PHASES (Progressive Unfreezing)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="165" y="1465" width="500" height="28" as="geometry" />
        </mxCell>
        <!-- Phase 1 -->
        <mxCell id="67" value="&lt;b&gt;Phase 1: FM Frozen (2,000 iterations)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;ViT1D_FM: FROZEN&lt;br/&gt;ViT2D, REPA, Classifier: Trainable&lt;br/&gt;LR: 2e-4 (uniform)&lt;br/&gt;Grad accumulation: 4 (eff. batch = 64)&lt;br/&gt;Warmup: 200 iterations&lt;br/&gt;Validation: every 500 iters (1,000 perms)&lt;br/&gt;~35 min training time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="1505" width="360" height="240" as="geometry" />
        </mxCell>
        <!-- Phase 2 -->
        <mxCell id="68" value="&lt;b&gt;Phase 2: All Unfrozen (12,000 iterations)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;All components: Trainable&lt;br/&gt;Differential LRs:&lt;br/&gt;  ViT1D_FM, ViT2D: 2e-5 (preserve pretrained)&lt;br/&gt;  REPA, Classifier: 2e-4 (task-specific)&lt;br/&gt;Grad accumulation: 2 (eff. batch = 32)&lt;br/&gt;Warmup: 100 iterations&lt;br/&gt;Validation: every 500 iters (10,000 perms)&lt;br/&gt;Mixed Precision AMP: yes&lt;br/&gt;Grad clip: max_norm = 1.0&lt;br/&gt;~8-10 hours training time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="1505" width="400" height="240" as="geometry" />
        </mxCell>
        <!-- Optimizer -->
        <mxCell id="69" value="&lt;b&gt;Optimizer: AdamW&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Linear LR warmup then constant&lt;br/&gt;AMP (autocast + GradScaler)&lt;br/&gt;Best checkpoint by val TPR@5%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1170" y="1540" width="260" height="90" as="geometry" />
        </mxCell>
        <!-- Metric -->
        <mxCell id="70" value="&lt;b&gt;Primary Metric: TPR@5%&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;PhysioNet/CinC 2025 official metric&lt;br/&gt;Sensitivity at 5% population screened&lt;br/&gt;10,000 permutation test&lt;br/&gt;Also: AUROC, AUPRC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1540" width="300" height="90" as="geometry" />
