        <mxCell id="M1" value="&lt;b&gt;Alignment Module (REPA)&lt;/b&gt;&lt;br&gt;• Depthwise Conv1d&lt;br&gt;• SiLU activation&lt;br&gt;• MLP projection&lt;br&gt;• Cosine similarity loss &lt;i&gt;(Training only, λ=0.5)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#F9A825;strokeWidth=2;fontSize=10;align=center;shadow=1;" vertex="1" parent="1">
